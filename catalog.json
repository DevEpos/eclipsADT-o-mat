  "adt": {
    "id": "adt-core",
    "name": "ABAP Development Tools",
    "description": "SAP's official ABAP Development Tools for Eclipse (required foundation for all ABAP/ADT features, including CDS, DDIC and debugger tooling).",
    "repoUrlTemplate": "https://tools.hana.ondemand.com/{version}",
    "additionalRepoUrlTemplates": [
      "https://download.eclipse.org/releases/{version}"
    ],
    "installableUnits": [
      "com.sap.adt.core.feature.group",
      "org.eclipse.emf.ecore.feature.group",
      "org.eclipse.emf.workspace.feature.group",
      "org.eclipse.emf.databinding.edit.feature.group",
      "org.eclipse.emf.validation.feature.group"
    ],
    "required": true
  },
  "plugins": [
    {
      "id": "devepos-search-tools",
      "name": "ABAP Search and Analysis Tools",
      "description": "DevEpos: Enhanced search and analysis tools for ABAP repository objects.",
      "category": "devepos",
      "channel": "stable",
      "repoUrl": "https://eclipse.devepos.com/latest",
      "installableUnits": ["com.devepos.adt.searchandanalysistools.feature.group"]
    },
    {
      "id": "devepos-tags",
      "name": "ABAP Tags",
      "description": "DevEpos: Tag and organize ABAP repository objects, and search by tag.",
      "category": "devepos",
      "channel": "stable",
      "repoUrl": "https://eclipse.devepos.com/latest",
      "installableUnits": ["com.devepos.adt.abaptags.feature.group"]
    },
    {
      "id": "devepos-code-search",
      "name": "ABAP Code Search",
      "description": "DevEpos: Fast full-text/code search across ABAP repository objects.",
      "category": "devepos",
      "channel": "stable",
      "repoUrl": "https://eclipse.devepos.com/latest",
      "installableUnits": ["com.devepos.adt.codesearch.feature.group"]
    },
    {
      "id": "devepos-pdt-tools",
      "name": "PDT Tools (ADT Plugin Development Tools)",
      "description": "DevEpos: Tooling to support development of ADT plug-ins themselves.",
      "category": "devepos",
      "channel": "stable",
      "repoUrl": "https://eclipse.devepos.com/latest",
      "installableUnits": ["com.devepos.adt.pdt.feature.group"]
    },
    {
      "id": "github-copilot",
      "name": "GitHub Copilot",
      "description": "Third-party: GitHub Copilot AI pair programmer integration for Eclipse.",
      "category": "third-party",
      "channel": "stable",
      "repoUrl": "https://azuredownloads-g3ahgwb5b8bkbxhd.b01.azurefd.net/github-copilot/",
      "installableUnits": ["com.microsoft.copilot.eclipse.feature.feature.group"]
    }
  ]
